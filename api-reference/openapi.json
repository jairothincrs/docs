{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartApe API",
    "version": "1.0.0",
    "description": "API generada a partir de la colección Postman 'SmartApe v1'.",
    "contact": {
      "name": "SmartApe Team"
    }
  },
  "servers": [
    {
      "url": "https://dfofxhxkdkwelswhzyyp.supabase.co/functions/v1"
    }
  ],
  "paths": {
    "/invoke-service": {
      "post": {
        "summary": "Invocar servicio (multipart/form-data o application/json)",
        "description": "Permite invocar un servicio de SmartApe mediante JSON o multipart form-data.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "api_key": {
                    "type": "string",
                    "example": "sk_GC8pUZdsTk42kHG6EhBW3ge7E8OFvSBX"
                  },
                  "service_id": {
                    "type": "string",
                    "example": "9428c921-f57d-4a28-8dd8-14e30269cb1e"
                  },
                  "endpoint_id": {
                    "type": "string",
                    "example": "1dca4c67-8316-4c20-9e2a-2f7a6f7fddc5"
                  },
                  "file_path": {
                    "type": "string",
                    "example": "/viajes/filipinas-manila.pdf"
                  },
                  "file_upload": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo a subir"
                  }
                },
                "required": ["api_key", "service_id", "endpoint_id"]
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "api_key": {
                    "type": "string",
                    "example": "sk_GC8pUZdsTk42kHG6EhBW3ge7E8OFvSBX"
                  },
                  "service_id": {
                    "type": "string",
                    "example": "9428c921-f57d-4a28-8dd8-14e30269cb1e"
                  },
                  "endpoint_id": {
                    "type": "string",
                    "example": "1dca4c67-8316-4c20-9e2a-2f7a6f7fddc5"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "file_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://viajarlh.com/wp-content/uploads/2021/02/BARRANCAS-ESPECTACULAR.pdf"
                      },
                      "file_path": {
                        "type": "string",
                        "example": "viajes/BARRANCAS-ESPECTACULAR.pdf"
                      }
                    }
                  }
                },
                "required": ["api_key", "service_id", "endpoint_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Petición exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "success",
                    "message": "Servicio invocado correctamente",
                    "data": {}
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error en la solicitud (parámetros inválidos)"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    }
  },
  "components": {}
}
